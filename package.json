{
  "name": "backtrack-ledger",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Backtracking cost ledger for JavaScript regular expressions: measured step counts, attack-string construction, and bounded verification of rewrites. Built on regexp-tree.",
  "repository": "llinok111/backtrack-ledger",
  "homepage": "https://github.com/llinok111/backtrack-ledger",
  "bugs": "https://github.com/llinok111/backtrack-ledger/issues",
  "scripts": {
    "build": "node ./scripts/build.js",
    "watch": "node ./scripts/build.js --watch",
    "pretest": "node ./scripts/build.js",
    "test": "jest",
    "demo:bundle": "node ./scripts/bundle-demo.js demo/regexp-tree.browser.js",
    "verify:demo": "node ./scripts/verify-demo.js",
    "eslint": "eslint ./src/ && eslint ./bin/regexp-tree",
    "prepublishOnly": "npm run build && npm test",
    "smoke": "node ./scripts/smoke-dist.js"
  },
  "bin": {
    "regexp-tree": "./bin/regexp-tree",
    "backtrack-ledger": "./bin/backtrack-ledger"
  },
  "keywords": [
    "regexp",
    "redos",
    "backtracking",
    "catastrophic-backtracking",
    "parser",
    "AST",
    "JavaScript"
  ],
  "author": "Dmitry Soshnikov",
  "contributors": [
    "backtrack-ledger layer"
  ],
  "files": [
    "src",
    "bin",
    "dist",
    "demo",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "devDependencies": {
    "babel-cli": "^6.26.0",
    "babel-preset-env": "1.6.1",
    "babel-preset-flow": "6.23.0",
    "eslint": "^8.52.0",
    "jest-cli": "^29.0.2",
    "prettier": "^1.17.1",
    "shelljs": "^0.8.5",
    "syntax-cli": "^0.1.11"
  }
}
